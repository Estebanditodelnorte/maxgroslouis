---
import Layout from '../layouts/Layout.astro';

const photos = [
  'Photo 88.jpg',
  'Photo 10.jpg',
  'Photo 4.jpg',
  'Photo 93.jpg',
  'Photo 91.jpg',
  'Photo 92.jpg',
  'Photo 60.jpg',
  'Photo 13.jpg',
];

const photosUtilisees = new Set([
  'Photo 88.jpg',
  'Photo 10.jpg',
  'Photo 93.jpg',
  'Photo 91.jpg',
  'Photo 13.jpg',
]);
const photoPath = (name) => {
  if (name === 'Photo 4.jpg') {
    return '/images/webp/totems-huron-wendake.webp';
  }
  return `/images/Photos/${photosUtilisees.has(name) ? 'Photos_utilisées/' : ''}${encodeURIComponent(name)}`;
};
const photoAlt = (name, index) =>
  name === 'Photo 4.jpg' ? 'Songs in Cedar' : `Gallery photo ${index + 1}`;
---

<Layout title="Photos | Espace Musée Oné Onti Max Gros-Louis">
  <section class="photos-hero glass-panel">
    <div>
      <p class="eyebrow">Photo Archive</p>
      <h1>Moments from the museum, community, and collection.</h1>
      <p>
        A visual record of gatherings, installations, and the people who keep the legacy of Max Gros-Louis alive.
      </p>
      <p>
        These images document museum collections, exhibition preparation, community moments, and heritage objects connected to Wendake, the Huron-Wendat Nation, and the cultural legacy of Grand Chief Max Gros-Louis.
      </p>
      <p>
        The gallery helps preserve visual memory around artifacts, installations, public gatherings, and the people whose work continues to shape the museum’s mission, exhibitions, and cultural transmission.
      </p>
      <p>
        Visitors, researchers, and partners can use this archive to better understand the atmosphere of the museum project, the range of collected material, and the public history work being developed around Grand Chief Max Gros-Louis.
      </p>
      <p>
        Together, these photographs add context to the museum’s exhibitions, collections care, and community relationships in Wendake.
      </p>
    </div>
  </section>

  <section class="photo-gallery">
    {photos.map((photo, index) => (
      <figure class="photo-card">
        <img
          src={photoPath(photo)}
          alt={photoAlt(photo, index)}
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))}
  </section>
</Layout>

<style>
  section {
    margin-top: clamp(2rem, 6vw, 4rem);
  }

  .photos-hero {
    display: grid;
    gap: 1rem;
  }

  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .photo-card {
    margin: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    background: rgba(12, 24, 18, 0.6);
    border: var(--global-card-border);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.28);
  }

  .photo-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
