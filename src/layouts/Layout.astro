---
import Navigation from '../components/Navigation.astro';
import PageFooter from '../components/PageFooter.astro';
const { title, description, image, noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const normalizedPath = pathname === '/' ? '/' : pathname.replace(/\/+$/, '');
const isFrench = pathname.startsWith('/fr');
const site = Astro.site ?? new URL('https://maxgroslouis.com');
const siteName = 'Espace Musee One Onti Max Gros-Louis';
const altPath = (() => {
  if (isFrench) {
    const stripped = pathname.replace(/^\/fr/, '') || '/';
    return stripped;
  }
  return pathname === '/' ? '/fr' : `/fr${pathname}`;
})();
const langLabel = isFrench ? 'English' : 'Français';
const langCode = isFrench ? 'fr' : 'en';
const canonicalUrl = new URL(pathname, site).toString();
const alternateUrl = new URL(altPath, site).toString();
const locale = isFrench ? 'fr_CA' : 'en_CA';
const alternateLocale = isFrench ? 'en_CA' : 'fr_CA';
const organizationName = 'Espace Musee One Onti Max Gros-Louis';
const organizationId = `${new URL('/', site).toString()}#organization`;
const websiteId = `${new URL('/', site).toString()}#website`;
const webpageId = `${canonicalUrl}#webpage`;
const defaultDescriptions = {
  '/': 'Museum in Wendake honoring Grand Chief Max Gros-Louis, Huron-Wendat heritage, exhibits, archives, and community memory.',
  '/about': 'Learn the museum mission, governance, milestones, and Huron-Wendat cultural stewardship in Wendake.',
  '/contact': 'Contact the Wendake museum for visits, partnerships, programming, research, and community inquiries.',
  '/events': 'See workshops, consultations, outreach, and museum events linked to Max Gros-Louis and Wendake.',
  '/exhibits': 'Explore exhibits, archives, oral histories, and First Nations heritage connected to Max Gros-Louis.',
  '/membership': 'Support the museum through membership, donations, preservation, exhibitions, and cultural programs.',
  '/photos': 'Browse museum photos, collection highlights, exhibits, and community moments from Wendake.',
  '/privacy': 'Read the website privacy policy, data practices, and Quebec Law 25 compliance details.',
  '/visit': 'Plan a visit to the museum in Wendake near Quebec City with address, access, hours, and visitor details.',
  '/fr': 'Musee a Wendake, pres de Quebec, dedie au Grand Chef Max Gros-Louis et au patrimoine huron-wendat.',
  '/fr/about': 'Decouvrez la mission, la gouvernance, les jalons et la transmission culturelle du musee a Wendake.',
  '/fr/contact': 'Communiquez avec le musee de Wendake pour les visites, partenariats et demandes communautaires.',
  '/fr/events': 'Consultez les ateliers, consultations, activites et evenements du musee lies a Max Gros-Louis a Wendake.',
  '/fr/exhibits': 'Explorez les expositions, archives, recits oraux et patrimoines autochtones lies a Max Gros-Louis.',
  '/fr/membership': 'Soutenez le musee par l adhesion, les dons, les expositions et la preservation culturelle.',
  '/fr/photos': 'Parcourez les photos du musee, de la collection, des expositions et de la communaute.',
  '/fr/privacy': 'Consultez la politique de confidentialite, les pratiques de donnees et la conformite a la Loi 25.',
  '/fr/visit': 'Preparez votre visite du musee a Wendake, pres de Quebec, avec l adresse, l acces et le statut actuel.',
};
const defaultImages = {
  '/': '/images/webp/max.webp',
  '/about': '/images/webp/chief-chirac-pelletier.webp',
  '/contact': '/images/webp/community-speaker.webp',
  '/events': '/images/webp/council-circle.webp',
  '/exhibits': '/images/webp/mask-gallery.webp',
  '/membership': '/images/webp/community-collection.webp',
  '/photos': '/images/webp/totems-huron-wendake.webp',
  '/privacy': '/images/webp/emgl-logo.webp',
  '/visit': '/images/webp/visitor-elder.webp',
  '/fr': '/images/webp/max.webp',
  '/fr/about': '/images/webp/chief-chirac-pelletier.webp',
  '/fr/contact': '/images/webp/community-speaker.webp',
  '/fr/events': '/images/webp/council-circle.webp',
  '/fr/exhibits': '/images/webp/mask-gallery.webp',
  '/fr/membership': '/images/webp/community-collection.webp',
  '/fr/photos': '/images/webp/totems-huron-wendake.webp',
  '/fr/privacy': '/images/webp/emgl-logo.webp',
  '/fr/visit': '/images/webp/visitor-elder.webp',
};
const defaultKeywords = {
  '/': 'Max Gros-Louis, Wendake museum, Huron-Wendat Nation, Indigenous museum Quebec, First Nations heritage, archives, exhibits',
  '/about': 'Max Gros-Louis biography, museum mission, governance, Wendake, Huron-Wendat heritage, cultural stewardship',
  '/contact': 'museum contact Wendake, Max Gros-Louis museum phone, email, partnerships, research inquiries',
  '/events': 'museum events Wendake, heritage workshop, oral history, community consultation, Max Gros-Louis events',
  '/exhibits': 'museum exhibits Wendake, Max Gros-Louis collection, archives, oral history, First Nations heritage',
  '/membership': 'museum membership, donate to museum, Wendake heritage support, cultural preservation',
  '/photos': 'museum photos, Max Gros-Louis photos, Wendake collection, exhibit gallery',
  '/privacy': 'privacy policy, Law 25, museum website privacy, data protection',
  '/visit': 'visit museum Wendake, Quebec City day trip, museum address, visitor information, guided groups',
  '/fr': 'quoi faire a Quebec, Wendake, musee Max Gros-Louis, nation huronne-wendat, patrimoine autochtone',
  '/fr/about': 'mission du musee, gouvernance, jalons, patrimoine huron-wendat, Wendake',
  '/fr/contact': 'contact musee Wendake, telephone, courriel, partenariats, demandes de recherche',
  '/fr/events': 'quoi faire a Quebec, evenements Wendake, ateliers patrimoniaux, histoire orale, tourisme autochtone',
  '/fr/exhibits': 'expositions musee, collection Max Gros-Louis, archives, patrimoine autochtone',
  '/fr/membership': 'adhesion musee, dons, preservation culturelle, soutien au patrimoine',
  '/fr/photos': 'photos musee, galerie, collection, expositions, communaute Wendake',
  '/fr/privacy': 'politique de confidentialite, Loi 25, protection des donnees',
  '/fr/visit': 'quoi faire a Quebec, visiter Wendake, musee pres de Quebec, adresse, acces, groupes guides',
};
const pageImage = image ?? defaultImages[normalizedPath] ?? defaultImages[isFrench ? '/fr' : '/'];
const imageUrl = new URL(pageImage, site).toString();
const pageDescription = description ?? defaultDescriptions[normalizedPath] ?? defaultDescriptions[isFrench ? '/fr' : '/'];
const pageKeywords = defaultKeywords[normalizedPath] ?? defaultKeywords[isFrench ? '/fr' : '/'];
const pageTypes = {
  '/': 'AboutPage',
  '/about': 'AboutPage',
  '/contact': 'ContactPage',
  '/events': 'CollectionPage',
  '/exhibits': 'CollectionPage',
  '/membership': 'AboutPage',
  '/photos': 'CollectionPage',
  '/privacy': 'WebPage',
  '/visit': 'AboutPage',
  '/fr': 'AboutPage',
  '/fr/about': 'AboutPage',
  '/fr/contact': 'ContactPage',
  '/fr/events': 'CollectionPage',
  '/fr/exhibits': 'CollectionPage',
  '/fr/membership': 'AboutPage',
  '/fr/photos': 'CollectionPage',
  '/fr/privacy': 'WebPage',
  '/fr/visit': 'AboutPage',
};
const pageSchemaType = pageTypes[normalizedPath] ?? 'WebPage';
const breadcrumbLabels = {
  '': isFrench ? 'Accueil' : 'Home',
  about: isFrench ? 'A propos' : 'About',
  contact: 'Contact',
  events: isFrench ? 'Evenements' : 'Events',
  exhibits: isFrench ? 'Expositions' : 'Exhibits',
  membership: isFrench ? 'Adhesion' : 'Membership',
  photos: 'Photos',
  privacy: isFrench ? 'Confidentialite' : 'Privacy',
  visit: isFrench ? 'Visiter' : 'Visit',
  fr: 'Accueil',
};
const baseHomeUrl = new URL(isFrench ? '/fr/' : '/', site).toString();
const pathSegments = pathname.split('/').filter(Boolean);
const breadcrumbSegments = isFrench ? pathSegments.slice(1) : pathSegments;
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: isFrench ? 'Accueil' : 'Home',
    item: baseHomeUrl,
  },
  ...breadcrumbSegments.map((segment, index) => {
    const relativePath = `${isFrench ? '/fr' : ''}/${breadcrumbSegments.slice(0, index + 1).join('/')}`;
    return {
      '@type': 'ListItem',
      position: index + 2,
      name: breadcrumbLabels[segment] ?? segment,
      item: new URL(relativePath, site).toString(),
    };
  }),
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: organizationName,
    url: new URL('/', site).toString(),
    logo: new URL('/images/webp/emgl-logo.webp', site).toString(),
    image: imageUrl,
    email: 'espacemaxoneontigroslouis@gmail.com',
    telephone: '+1-819-790-9888',
    sameAs: ['https://www.facebook.com/profile.php?id=61581850003312'],
    address: {
      '@type': 'PostalAddress',
      streetAddress: '97 Boulevard Bastien',
      addressLocality: 'Wendake',
      addressRegion: 'QC',
      postalCode: 'G0A 4V0',
      addressCountry: 'CA',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Museum',
    '@id': `${new URL('/', site).toString()}#museum`,
    name: organizationName,
    url: new URL('/', site).toString(),
    description: defaultDescriptions['/'],
    image: imageUrl,
    telephone: '+1-819-790-9888',
    email: 'espacemaxoneontigroslouis@gmail.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '97 Boulevard Bastien',
      addressLocality: 'Wendake',
      addressRegion: 'QC',
      postalCode: 'G0A 4V0',
      addressCountry: 'CA',
    },
    areaServed: 'Canada',
    inLanguage: ['en-CA', 'fr-CA'],
    sameAs: ['https://www.facebook.com/profile.php?id=61581850003312'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    url: new URL('/', site).toString(),
    name: organizationName,
    inLanguage: ['en-CA', 'fr-CA'],
    publisher: {
      '@id': organizationId,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': pageSchemaType,
    '@id': webpageId,
    url: canonicalUrl,
    name: title,
    description: pageDescription,
    isPartOf: {
      '@id': websiteId,
    },
    about: {
      '@id': `${new URL('/', site).toString()}#museum`,
    },
    inLanguage: langCode,
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: imageUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  },
];
---

<html lang={langCode}>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="robots" content={noindex ? 'noindex,nofollow,noarchive,nosnippet,noimageindex' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={langCode} href={canonicalUrl} />
    <link rel="alternate" hreflang={isFrench ? 'en' : 'fr'} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
    <style is:global>
        @import '../styles/global.css';
    </style>
</head>
<body>
    <a class="lang-toggle" href={altPath}>{langLabel}</a>
    <Navigation />
    <main class="forest-shell glass-panel">
        <slot />
    </main>
    {pathname !== '/' && pathname !== '/fr' && <PageFooter isFrench={isFrench} />}
    <p class="site-copyright">
        Copyright © 2026 Espace Max Oné Onti Gros-Louis.
        <span>Tous droits réservés.</span>
        <span>
          {isFrench
            ? 'Conforme à la Loi 25 du Québec – Aucun traceur ni technologie de suivi non essentielle n’est utilisé sur ce site.'
            : 'Compliant with Québec’s Law 25 – No trackers or non-essential tracking technologies are used on this site.'}
        </span>
    </p>
</body>

<style>
    body {
        position: relative;
        overflow-x: hidden;
    }

    .forest-shell {
        position: relative;
        z-index: 1;
        margin-top: clamp(1rem, 4vw, 3rem);
        margin-bottom: clamp(2rem, 6vw, 4rem);
    }

    .lang-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 3;
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        border: 1px solid var(--global-border-alt-color);
        background: rgba(5, 15, 9, 0.8);
        color: var(--global-base-t-color);
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        backdrop-filter: blur(6px);
    }

    .site-copyright {
        margin: 0;
        padding: 0 1rem 2rem;
        text-align: center;
        font-size: 0.8rem;
        color: var(--global-accent-color);
    }

    .site-copyright span {
        display: block;
        margin-top: 0.2rem;
    }

</style>
</html>
